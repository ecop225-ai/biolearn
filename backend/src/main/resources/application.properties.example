# Copia este archivo como application.properties (sin .example) y completa tus datos reales.
# application.properties NO se sube a git (ver .gitignore).

server.port=8080

# --- Base de datos ---
spring.datasource.url=jdbc:mysql://localhost:3306/biolearn_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Bogota&createDatabaseIfNotExist=true
spring.datasource.username=biolearn_user
spring.datasource.password=CAMBIA_ESTA_CLAVE
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# --- JPA / Hibernate ---
# 'none': el esquema lo administra por completo schema.sql, Hibernate nunca lo modifica.
spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# --- JWT ---
biolearn.jwt.secret=CAMBIA_ESTE_VALOR_POR_UNA_CLAVE_SECRETA_LARGA_Y_ALEATORIA_MINIMO_32_CARACTERES
biolearn.jwt.expiration-ms=28800000

# --- CORS (frontend permitido) ---
biolearn.cors.allowed-origin=http://127.0.0.1:5500

# --- Swagger / OpenAPI ---
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.api-docs.path=/v3/api-docs

# --- Correo (SMTP) ---
# Sin estos datos el backend no envía correos: los enlaces de activación, invitación y recuperación
# y las facturas quedan en la consola. Con Gmail se usa una "contraseña de aplicación" (16 letras),
# no la contraseña normal de la cuenta. NUNCA subas este archivo con la clave real a GitHub.
biolearn.correo.habilitado=false
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=biolearn.notificaciones@gmail.com
spring.mail.password=PEGA_AQUI_LA_CONTRASENA_DE_APLICACION
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.connectiontimeout=10000
spring.mail.properties.mail.smtp.timeout=10000
spring.mail.properties.mail.smtp.writetimeout=10000
# Desarrollo: si se llena, TODOS los correos llegan a este buzón (con el destinatario original en el asunto)
biolearn.correo.redirigir-a=
# Pantalla de Auth a la que apuntan los enlaces de los correos
biolearn.frontend.url-auth=http://127.0.0.1:5173/prototipo-auth/biolearn_auth_prototipo.html
