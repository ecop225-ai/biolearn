# ================================================================
# BioLearn — configuración de la aplicación
# Copia este archivo a application.properties y ajusta usuario/clave
# ================================================================

# --- Servidor ---
server.port=8080

# --- Base de datos MySQL ---
# Antes de correr la app, crea la base con: CREATE DATABASE biolearn_db;
spring.datasource.url=jdbc:mysql://localhost:3306/biolearn_db?useSSL=false&serverTimezone=America/Bogota&createDatabaseIfNotExist=true
spring.datasource.username=biolearn_user
spring.datasource.password=CAMBIA_ESTA_CLAVE
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# --- JPA / Hibernate ---
# 'update' es cómodo en desarrollo (crea/ajusta tablas solas).
# En producción usar 'validate' y manejar el esquema con scripts de migración (Flyway/Liquibase).
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# --- JWT ---
# Genera tu propia clave secreta larga y aleatoria (no uses esta de ejemplo en producción)
biolearn.jwt.secret=CAMBIA_ESTE_VALOR_POR_UNA_CLAVE_SECRETA_LARGA_Y_ALEATORIA_1234567890
biolearn.jwt.expiration-ms=28800000

# --- CORS (dominio del frontend en desarrollo) ---
biolearn.cors.allowed-origin=http://localhost:5173
