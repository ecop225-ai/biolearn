# =====================================================================
# BioLearn · Variables del servidor
# En el servidor:  cp .env.example .env   y luego edita .env con  nano .env
# .env tiene las claves reales: NO se sube a GitHub (está en .gitignore) y no se comparte en capturas.
# =====================================================================

# Dirección pública del sitio, sin barra al final (la IP estática de Azure o la etiqueta DNS)
SITIO_URL=http://64.236.158.56

# Dominio gratuito del sitio (por ejemplo biolearn-sena.duckdns.org), sin http:// ni barra.
# Con el dominio y el certificado (bash scripts/https.sh), SITIO_URL pasa a ser https://<dominio>.
DOMINIO=

# MySQL: inventa dos contraseñas largas (solo letras y números, para no tener problemas con símbolos)
MYSQL_ROOT_PASSWORD=CAMBIA_ESTA_CLAVE_ROOT
MYSQL_USER=biolearn_user
MYSQL_PASSWORD=CAMBIA_ESTA_CLAVE_APP

# Clave para firmar los tokens JWT (mínimo 32 caracteres). Genérala en el servidor con:  openssl rand -hex 32
JWT_SECRET=CAMBIA_ESTE_VALOR_POR_EL_RESULTADO_DE_OPENSSL

# Correo: déjalo en false para la demostración (los enlaces se leen en el registro del backend).
# Si algún día se activa, la clave de aplicación de Gmail se escribe SOLO aquí, en el servidor.
CORREO_HABILITADO=false
CORREO_USUARIO=
CORREO_CLAVE_APLICACION=
